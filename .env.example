# OB-AutoPost Pasarela (Gateway) Settings
# URL pública del backend de OB-AutoPost (ej: https://autopost.otherbrain.tech o http://localhost:8087)
NEXT_PUBLIC_OB_GATEWAY_URL=https://autopost.otherbrain.tech

# API Key del Tenant registrado en OB-AutoPost (por defecto en desarrollo: dev_api_key_123)
NEXT_PUBLIC_OB_API_KEY=dev_api_key_123
OB_API_KEY=dev_api_key_123

# ID del Tenant (UUID asignado al cliente SaaS en PostgreSQL)
NEXT_PUBLIC_OB_TENANT_ID=11111111-2222-3333-4444-555555555555
OB_TENANT_ID=11111111-2222-3333-4444-555555555555

# ID del Usuario activo dentro de tu SaaS (ej: user_123, demo_client_user)
NEXT_PUBLIC_DEFAULT_CLIENT_USER_ID=demo_client_user
